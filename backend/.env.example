# =============================================================
# Dodong OS environment template
#
# Copy to `.env` for local development, or set these as real
# environment variables in production. NEVER commit a filled-in
# `.env` (it is gitignored). Placeholders only below.
# =============================================================

# ------------------------------------------------------------------
# Django  (REQUIRED in production)
# ------------------------------------------------------------------
# development | production  (production flips secure defaults on and
# refuses SQLite / DEBUG / missing SECRET_KEY)
DJANGO_ENV=development
# Required. Generate: python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-50+-char-random-string
# Must be False in production.
DEBUG=True
# Required in production. Comma-separated hostnames.
ALLOWED_HOSTS=localhost,127.0.0.1
# Required in production for admin/HTMX POSTs over HTTPS. Comma-separated, scheme included.
CSRF_TRUSTED_ORIGINS=https://your-domain.example.com
# Set to 1 in CI / containers to ignore any .env file.
DJANGO_SKIP_DOTENV=0

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# Omit for local SQLite. REQUIRED in production (PostgreSQL DSN):
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
# Seconds to keep a pooled DB connection open (production).
DB_CONN_MAX_AGE=60

# ------------------------------------------------------------------
# AI provider
# ------------------------------------------------------------------
# openai | ollama
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.6-luna
# Only if AI_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434

# ------------------------------------------------------------------
# Background automation  (python manage.py run_crm_checks)
# ------------------------------------------------------------------
CRM_DUE_SOON_HOURS=48
CRM_STALE_LEAD_DAYS=14
CRM_AUTOMATION_STALE_RUN_MINUTES=30
CRM_AUTOMATION_AI_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------
# RAG / AI Memory
# ------------------------------------------------------------------
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_RETRIEVAL_LIMIT=5
RAG_AI_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------
# Production hardening  (defaults follow DJANGO_ENV; override only if needed)
# ------------------------------------------------------------------
# LOG_LEVEL=INFO
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False
# USE_X_FORWARDED_PROTO=True
# WEB_CONCURRENCY=3
